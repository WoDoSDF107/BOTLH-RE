<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="true" id="44f3-7dc2-b2b0-fe8b" name="Automatons - Library" gameSystemId="sys-0cac-03d0-97e0-4db0" gameSystemRevision="33" revision="1" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <rules>
    <rule name="Fetch, Decode, Execute" id="951e-0d6a-b6c5-1f9b" hidden="false">
      <description>When an Automaton unit with this rule makes an attack against an enemy infantry unit, after selecting a target but before making any rolls, select one body part to target. 
**Head**: Until all attacks have been resolved, this unit&apos;s weapons suffer a -1 to hit rolls, but receive an improvement of 1 to their AP characteristic. 
**Body**: Until all attacks have been resolved, this unit&apos;s weapons receive a +1 to hit rolls. 
**Arms**: Until the start of your next turn, enemy units successfully hit by this attack suffer a -1 to hit rolls.
**Legs**: Until the start of your next turn, enemy units successfully hit by this attack suffer a -2&quot; to their Movement characteristic.
Each effect can only be applied once per unit.</description>
    </rule>
  </rules>
