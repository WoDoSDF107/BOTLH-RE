              <rules>
                <rule name="Jet Brigade" id="739c-da71-af5f-fb53" hidden="false">
                  <description>You may only take Infantry Units (and a maximum of 1 of each Hulk variant) as part of your army, however, all units in your army have the Fly keyword, and have the Jet Pack Jump ability. (Excluded units: Heavy Devastator)</description>
                </rule>
              </rules>
              <profiles>
                <profile name="Jet Pack Jump" typeId="fe4c-5b77-ab77-e578" typeName="Abilities" hidden="false" id="47a2-4e94-35fa-c8b2">
                  <characteristics>
                    <characteristic name="Description" typeId="5cee-5283-c95d-c323">Once per battle, at the start of your movement phase, change this unit’s movement characteristic to 12” until the end of the phase. Until the start of your next turn after using this ability, enemy units targeting this unit with Ranged Weapons receive a -1 to hit rolls.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
