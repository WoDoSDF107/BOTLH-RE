        <profile name="Fabricator" typeId="fe4c-5b77-ab77-e578" typeName="Abilities" hidden="false" id="6235-8321-f19b-0aa6">
          <characteristics>
            <characteristic name="Description" typeId="5cee-5283-c95d-c323">This ability may be performed in the Reinforcements step of your Movement Phase. If you have any destroyed Trooper units, roll a D6. On a 2+, return one Trooper unit (not including any attached characters, but including any additional Wargear assigned to that unit) to the battlefield within 3&quot; of this fortification.</characteristic>
          </characteristics>
        </profile>
