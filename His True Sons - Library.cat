                    <profile name="Facsimile of The Righteous Fury - Flail Forme" typeId="40ae-6307-2b25-7cc0" typeName="Ranged Weapons" hidden="false" id="121d-5922-cb21-6f0e">
                      <characteristics>
                        <characteristic name="Range" typeId="910b-bab0-6061-64b0">2&quot;</characteristic>
                        <characteristic name="A" typeId="5e1d-ad8d-5f10-19e6">D6+3</characteristic>
                        <characteristic name="BS" typeId="61ae-df8d-ecfb-8c75">3+</characteristic>
                        <characteristic name="S" typeId="56b5-1ad0-6ed2-8b37">5</characteristic>
                        <characteristic name="AP" typeId="782f-75ab-b021-e58a">0</characteristic>
                        <characteristic name="D" typeId="c860-c282-c3a0-93e0">1</characteristic>
                        <characteristic name="Keywords" typeId="34fe-41f9-008b-920f">Pistol</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Armourbane" id="515d-7236-d276-7ca1" hidden="false">
                      <description>If the Strength characteristic of this weapon exceeds the Toughness characteristic of the target enemy model, improve the Armour Penetration characteristic of this weapon by 1 until all attacks have been resolved.</description>
                    </rule>
                  </rules>
