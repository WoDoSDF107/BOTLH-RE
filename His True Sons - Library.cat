          <profiles>
            <profile name="Nuntius Timoris" id="db0c-6d80-f914-05b3" hidden="false" typeId="6803-b921-1e0c-0322" typeName="Unit">
              <characteristics>
                <characteristic name="M" typeId="c100-b9db-eacc-d3e0">6&quot;</characteristic>
                <characteristic name="T" typeId="4e8c-3287-4126-05a4">6</characteristic>
                <characteristic name="SR" typeId="55e5-4318-7023-255d">3+</characteristic>
                <characteristic name="W" typeId="7547-1a30-8027-a225">3</characteristic>
                <characteristic name="OC" typeId="17b7-6486-cf25-b101">2</characteristic>
                <characteristic name="MF" typeId="dbfc-7c96-dcff-d55b">6</characteristic>
                <characteristic name="CC" typeId="f4e7-dd5b-6bb4-6485">3</characteristic>
              </characteristics>
            </profile>
            <profile name="Witness Them Suffer" id="13ef-8a9d-70a4-a556" hidden="false" typeId="fe4c-5b77-ab77-e578" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="5cee-5283-c95d-c323">During your Shooting Phase, select one visible enemy unit within 16&quot;, that unit must perform a Composure test. If that total is less than 20, that unit receives SHOCK. If that unit is within Engagement Range, that unit receives PANIC on a result less than 20.</characteristic>
              </characteristics>
            </profile>
            <profile name="Mind-Bending Screams" id="d982-b392-d280-89e3" hidden="false" typeId="fe4c-5b77-ab77-e578" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="5cee-5283-c95d-c323">When an enemy unit within 6&quot; of this model performs a Composure Test, subtract 1 from the total result of that test. If this unit is engaged with an enemy unit, instead subtract 2 from the total result.</characteristic>
              </characteristics>
