                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Forward Observer" id="5f88-352b-5d6f-6d90" hidden="false">
                  <description>If a Character model within your army has direct line of sight on an enemy unit, a weapon with the Forward Observer keyword counts as having line of sight on that unit as well, and that enemy unit may be targeted with this weapon regardless of the bearer&apos;s position on the board.</description>
                </rule>
              </rules>
