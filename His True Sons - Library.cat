                <profile name="Precision Air Strike" id="c9d8-da96-28ba-4310" hidden="false" typeId="fe4c-5b77-ab77-e578" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="5cee-5283-c95d-c323">To perform an attack with the Precision Air Strike weapon, place a Small blast marker anywhere within range of that weapon during your Shooting Phase. The model bearing that weapon cannot fire that weapon for the rest of this turn. At the start of your next Shooting Phase following this action, the model bearing this weapon may then select a target whose base is within range of that Small blast marker.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
