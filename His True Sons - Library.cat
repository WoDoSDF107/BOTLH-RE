                  <profiles>
                    <profile name="The Eye of God" id="5c9d-0330-32af-f7a9" hidden="false" typeId="9faa-64d3-43b4-045a" typeName="Support Weapons">
                      <characteristics>
                        <characteristic name="Description" typeId="15ec-a129-7e37-e62d">When an enemy model declares damage made with a melee weapon against a model with at least one Shield of Faith weapon, roll one D6 for every point of damage to be inflicted. On a 4+, that damage is instead allocated to the enemy model. When allocating damage, any models in the unit without a Shield of Faith weapon must be selected first.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Support Systems Charged" id="a014-2f59-f83d-b042" hidden="false" typeId="fe4c-5b77-ab77-e578" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="5cee-5283-c95d-c323">Whenever a model bearing The Eye of God Support Weapon performs a Save Roll against an attack made with Ranged Weapons, if the result of that roll is an unmodified 6, restore 1 lost wound to this unit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
