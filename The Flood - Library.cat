      <profiles>
        <profile name="Open the Casket" typeId="fe4c-5b77-ab77-e578" typeName="Abilities" hidden="false" id="1640-b855-11a8-a068">
          <characteristics>
            <characteristic name="Description" typeId="5cee-5283-c95d-c323">Each time a Flood Carrier model in this unit is destroyed, after the attacking unit has finished making its attacks, if this unit is not destroyed, roll one D6 for that model. On a 4+, add two Flood Infection Form models to this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Self-Combustion" typeId="fe4c-5b77-ab77-e578" typeName="Abilities" hidden="false" id="154b-cfc8-dcc1-8fec">
          <characteristics>
            <characteristic name="Description" typeId="5cee-5283-c95d-c323">When a model in this unit makes an attack with the Self-Combustion Melee Weapon, after resolving that attack, that model is destroyed, and may use the Open the Casket ability.</characteristic>
          </characteristics>
        </profile>
